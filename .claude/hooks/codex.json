{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "govctl agent hook session-start",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "govctl agent hook pre-tool-use",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ]
  }
}
