  ID: WI-<DATE>-002
exit: 0

$ govctl work list
[
  {
    "id": "WI-<DATE>-001",
    "status": "queue",
    "title": "Keep this work item"
  },
  {
    "id": "WI-<DATE>-002",
    "status": "queue",
    "title": "Delete this work item"
  }
]
exit: 0

$ govctl work delete WI-<DATE>-001 -f
