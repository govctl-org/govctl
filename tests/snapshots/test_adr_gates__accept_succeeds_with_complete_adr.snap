---
source: tests/adr_gate_tests/accept.rs
expression: snapshot
---
$ govctl adr new Test ADR
Created ADR: gov/adr/ADR-XXXX-test-adr.toml
exit: 0

$ govctl adr edit ADR-0001 context --set We need to pick a storage layer.
Set ADR-0001.context = We need to pick a storage layer.
exit: 0

$ govctl adr edit ADR-0001 alternatives --add Option A
Added 'Option A' to ADR-0001.alternatives
exit: 0

$ govctl adr edit ADR-0001 alternatives --add Option B
Added 'Option B' to ADR-0001.alternatives
exit: 0

$ govctl adr edit ADR-0001 alternatives[0] --tick accepted
Marked 'Option A' as accepted
exit: 0

$ govctl adr edit ADR-0001 alternatives[1] --tick rejected
Marked 'Option B' as rejected
exit: 0

$ govctl adr edit ADR-0001 decision --set We chose Option A.
Set ADR-0001.decision = We chose Option A.
exit: 0

$ govctl adr edit ADR-0001 consequences --set Faster reads, more memory.
Set ADR-0001.consequences = Faster reads, more memory.
exit: 0

$ govctl adr accept ADR-0001
Accepted ADR: ADR-0001
exit: 0

$ govctl adr list
┌──────────┬──────────┬────────────┬──────────┐
│ ADR      ┆ Status   ┆ Date       ┆ Title    │
╞══════════╪══════════╪════════════╪══════════╡
│ ADR-0001 ┆ accepted ┆ <DATE> ┆ Test ADR │
└──────────┴──────────┴────────────┴──────────┘
exit: 0
